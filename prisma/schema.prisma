generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  type                String   @default("COMPANY") // COMPANY, FARM, AGRO_ENTERPRISE, BRANCH
  legalName           String?
  taxId               String?  // GSTIN, VAT, EIN
  registrationNumber  String?
  email               String?
  phone               String?
  website             String?
  currency            String   @default("INR") // INR, USD, EUR, GBP, etc.
  currencySymbol      String   @default("₹")
  address             String?
  city                String?
  state               String?
  country             String?  @default("India")
  zipCode             String?
  bankName            String?
  bankAccount         String?
  bankIfscSwift       String?
  bankBranch          String?
  upiId               String?
  invoicePrefix       String   @default("INV-")
  estimatePrefix      String   @default("EST-")
  challanPrefix       String   @default("DC-")
  nextInvoiceNumber   Int      @default(1001)
  nextEstimateNumber  Int      @default(1001)
  logoUrl             String?
  notesTerms          String?  @default("Thank you for your business! Payment is due within 15 days of invoice date.")
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customers           Customer[]
  products            Product[]
  categories          Category[]
  invoices            Invoice[]
  estimates           Estimate[]
  payments            Payment[]
  expenses            Expense[]
  farmBatches         FarmBatch[]
}

model Customer {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  companyName     String?
  type            String   @default("CUSTOMER") // CUSTOMER, VENDOR, FARM_BUYER, DISTRIBUTOR
  email           String?
  phone           String?
  taxId           String?  // GSTIN / VAT
  billingAddress  String?
  shippingAddress String?
  city            String?
  state           String?
  zipCode         String?
  country         String?  @default("India")
  creditLimit     Float    @default(0)
  currentBalance  Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  estimates       Estimate[]
  payments        Payment[]

  @@index([organizationId])
}

model Category {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  type            String   @default("PRODUCT") // PRODUCT, SERVICE, CROP, LIVESTOCK, EXPENSE
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products        Product[]
  expenses        Expense[]

  @@index([organizationId])
}

model Product {
  id              String   @id @default(uuid())
  organizationId  String
  categoryId      String?
  sku             String?
  name            String
  description     String?
  unit            String   @default("unit") // kg, quintal, ton, box, bag, liter, acre, hr, unit
  salePrice       Float    @default(0)
  costPrice       Float    @default(0)
  taxRate         Float    @default(0) // Percentage: 0, 5, 12, 18, etc.
  hsnSacCode      String?  // HSN code for goods / SAC for services
  stockQuantity   Float    @default(0)
  lowStockAlert   Float    @default(5)
  isAgricultural  Boolean  @default(false)
  grade           String?  // Grade A, Grade B, Organic, Premium, etc.
  trackInventory  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invoiceItems    InvoiceItem[]
  estimateItems   EstimateItem[]

  @@index([organizationId])
}

model Invoice {
  id              String   @id @default(uuid())
  organizationId  String
  customerId      String
  invoiceNumber   String
  referenceNumber String?
  issueDate       DateTime @default(now())
  dueDate         DateTime
  status          String   @default("UNPAID") // DRAFT, SENT, PAID, PARTIAL, OVERDUE, CANCELLED
  type            String   @default("TAX_INVOICE") // TAX_INVOICE, PROFORMA, FARM_SALE, BILL_OF_SUPPLY
  subTotal        Float    @default(0)
  discountType    String   @default("FIXED") // FIXED or PERCENTAGE
  discountValue   Float    @default(0)
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  balanceAmount   Float    @default(0)
  notes           String?
  terms           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  productId       String?
  itemName        String
  description     String?
  quantity        Float    @default(1)
  unit            String   @default("unit")
  unitPrice       Float    @default(0)
  discountPercent Float    @default(0)
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0)

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Estimate {
  id                String   @id @default(uuid())
  organizationId    String
  customerId        String
  estimateNumber    String
  referenceNumber   String?
  issueDate         DateTime @default(now())
  expiryDate        DateTime
  status            String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, CONVERTED
  subTotal          Float    @default(0)
  discountType      String   @default("FIXED")
  discountValue     Float    @default(0)
  discountAmount    Float    @default(0)
  taxAmount         Float    @default(0)
  totalAmount       Float    @default(0)
  convertedInvoiceId String?
  notes             String?
  terms             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items             EstimateItem[]

  @@unique([organizationId, estimateNumber])
  @@index([organizationId])
  @@index([customerId])
}

model EstimateItem {
  id              String   @id @default(uuid())
  estimateId      String
  productId       String?
  itemName        String
  description     String?
  quantity        Float    @default(1)
  unit            String   @default("unit")
  unitPrice       Float    @default(0)
  discountPercent Float    @default(0)
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0)

  estimate        Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([estimateId])
}

model Payment {
  id              String   @id @default(uuid())
  organizationId  String
  invoiceId       String?
  customerId      String
  paymentNumber   String
  paymentDate     DateTime @default(now())
  amount          Float    @default(0)
  paymentMethod   String   @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, CHEQUE, UPI, CARD, ONLINE
  reference       String?
  notes           String?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice         Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([customerId])
}

model Expense {
  id              String   @id @default(uuid())
  organizationId  String
  categoryId      String?
  title           String
  vendor          String?
  amount          Float    @default(0)
  date            DateTime @default(now())
  paymentMethod   String   @default("CASH")
  reference       String?
  description     String?
  receiptUrl      String?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model FarmBatch {
  id                  String   @id @default(uuid())
  organizationId      String
  batchCode           String
  cropOrLivestock     String   // e.g., "Wheat HD-2967", "Basmati Rice", "Broiler Chicken", "Alphonso Mango"
  fieldLocation       String?  // e.g. "Sector North Plot 4"
  areaAcres           Float?   @default(0)
  plantedDate         DateTime?
  expectedHarvestDate DateTime?
  harvestDate         DateTime?
  expectedYield       Float?   @default(0) // in Kg / Quintal / Tons
  actualYield         Float?   @default(0)
  unit                String   @default("quintal")
  status              String   @default("GROWING") // PLANNED, GROWING, HARVESTED, SOLD, ARCHIVED
  costIncurred        Float    @default(0)
  revenueEarned       Float    @default(0)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
